# postgresql
DATABASE_URL="{get this from vercel}"
DATABASE_URL_NON_POOLING="{get this from vercel}"

# generate this per machine, per environment
# for example, using `openssl rand -base64 32` to generate a secure secret
NEXTAUTH_SECRET="NEXTAUTH_SECRET"

# Google OAuth credentials
# get these from the Google Cloud Console for your project
GOOGLE_CLIENT_ID="GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="GOOGLE_CLIENT_SECRET"

# the public URL of your site, used by NextAuth and other services
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Resend API key for sending emails
# get this from the Resend dashboard for your project
# (not used in development, so you can leave it as a placeholder)
RESEND_API_KEY="RESEND_API_KEY"